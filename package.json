{
  "name": "lead-operations-platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:typecheck": "tsc -p web/tsconfig.json",
    "start": "node dist/src/server.js",
    "worker:identity": "node dist/src/identity-worker.js",
    "worker:ai": "node dist/src/ai-worker.js",
    "worker:messaging": "node dist/src/messaging-worker.js",
    "worker:events": "node dist/src/messaging-events-worker.js",
    "worker:media": "node dist/src/media-worker.js",
    "worker:sources": "node dist/src/source-retrieval-worker.js",
    "worker:payments": "node dist/src/payment-worker.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:integration": "npm run build && node --test --test-concurrency=1 dist/test-integration/*.test.js",
    "test:e2e": "npm run build && npm run web:build && playwright test",
    "benchmark:messaging": "npm run build && node dist/scripts/benchmark-messaging.js",
    "db:migrate": "npm run build && node dist/scripts/migrate.js",
    "db:local": "npm run build && node dist/scripts/local-postgres.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@node-rs/argon2": "^2.0.0",
    "fastify": "^5.0.0",
    "file-type": "^22.1.1",
    "nodemailer": "^10.0.13",
    "postgres": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "esbuild@0.28.2": true
  }
}
