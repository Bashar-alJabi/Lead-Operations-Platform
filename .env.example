# Deployment secrets: generate independently for each environment. Never commit real values.
DATABASE_URL=postgres://lead_operations:CHANGE_ME@localhost:5432/lead_operations
APP_ORIGIN=http://127.0.0.1:5173
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# 32 random bytes encoded as 64 hex characters. Required before storing provider credentials.
CREDENTIAL_ENCRYPTION_KEY=
# A one-time secret for the initial Super Admin setup. Remove after bootstrap.
BOOTSTRAP_TOKEN=
# Independent Messaging event worker; infrastructure bounds, not provider/business limits.
MESSAGING_EVENT_BATCH_SIZE=50
MESSAGING_EVENT_POLL_MS=2000
# Infrastructure settings; business-managed messaging credentials stay in the platform UI.
MEDIA_STORAGE_BACKEND=local
MEDIA_LOCAL_ROOT=.local/media
MEDIA_MAX_BYTES=26214400
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# Production: private S3-compatible bucket with explicitly supplied deployment credentials.
# MEDIA_STORAGE_BACKEND=s3
# MEDIA_S3_BUCKET=
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_SESSION_TOKEN=
# AWS_REGION=
# MEDIA_S3_ENDPOINT=
# MEDIA_S3_FORCE_PATH_STYLE=false
